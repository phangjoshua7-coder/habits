rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Profiles Match definitions
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email is string;
      allow update: if isOwner(userId) 
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Habits Subcollections
    match /users/{userId}/habits/{habitId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(habitId);
      allow delete: if isOwner(userId);
    }

    // History Logs Subcollections
    match /users/{userId}/history/{logId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(logId);
      allow delete: if isOwner(userId);
    }
  }
}
